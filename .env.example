# ===== Computador (simulador) =====
# Chave da API do Claude (você coloca; nunca vai para o Git).
ANTHROPIC_API_KEY=

# ===== Só no servidor (Railway). No computador, deixe em branco. =====
# Endereço do Postgres. No Railway: use a referência ${{ Postgres.DATABASE_URL }}.
DATABASE_URL=

# Primeiro administrador (criado sozinho na primeira vez que o sistema sobe com o banco vazio).
# Escolha uma senha longa (mínimo 6, com letra, número e uma maiúscula). Depois de criado, estas variáveis são ignoradas.
ADMIN_LOGIN=
ADMIN_SENHA=
ADMIN_NOME=

# Pasta das imagens, vídeos e PDFs. No Railway: crie um Volume montado em /data e use /data/midias.
MIDIAS_DIR=
# Tamanho do seu Volume em MB (ex.: 5000 para 5 GB). Só serve para mostrar a porcentagem usada em Configurações.
MIDIAS_LIMITE_MB=

# WhatsApp oficial (Meta). Com as 4 preenchidas, o WhatsApp real liga. Em branco = modo simulado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
# Texto qualquer e longo, escolhido por você. É o mesmo que você digita na Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Chave mestra que criptografa as chaves de API salvas pela tela (Configurações > Chaves de API). Texto longo e secreto (mínimo 16).
# Obrigatória em produção para salvar chaves pela tela. Se trocar depois, as chaves salvas precisam ser coladas de novo.
CHAVE_MESTRA=
# Transcrição de áudio com o Whisper da OpenAI (opcional). Sem a chave, o bot avisa que não consegue ouvir áudios.
OPENAI_API_KEY=
# OPENAI_TRANSCRICAO_MODELO=gpt-4o-mini-transcribe   (padrão; para voltar ao antigo use whisper-1)

# Política de privacidade pública (/privacidade): contato para pedidos de dados e "aprovada" para tirar o aviso de rascunho.
PRIVACIDADE_CONTATO=
# PRIVACIDADE_APROVADA=1

# Opcionais (só mude se a Meta pedir): versão da API e idioma dos modelos de mensagem.
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_IDIOMA_MODELOS=pt_BR

# Opcionais
# MODO_SIMULADOR=1   (liga o Simulador e o relógio simulado. Em produção fica desligado; use só para testar sem WhatsApp.)
# ROTINAS_AUTO=0     (desliga as rotinas automáticas de retomada etc.)
