# ===== Computador (simulador) =====
# Chave da API do Claude (você coloca; nunca vai para o Git).
ANTHROPIC_API_KEY=

# ===== Só no servidor (Railway). No computador, deixe em branco. =====
# Endereço do Postgres. No Railway: use a referência ${{ Postgres.DATABASE_URL }}.
DATABASE_URL=

# Primeiro administrador (criado sozinho na primeira vez que o sistema sobe com o banco vazio).
# Escolha uma senha longa (mínimo 10 caracteres). Depois de criado, estas variáveis são ignoradas.
ADMIN_LOGIN=
ADMIN_SENHA=
ADMIN_NOME=

# Pasta das fotos e plantas. No Railway: crie um Volume montado em /data e use /data/midias.
MIDIAS_DIR=

# WhatsApp oficial (Meta). Com as 4 preenchidas, o WhatsApp real liga. Em branco = modo simulado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
# Texto qualquer e longo, escolhido por você. É o mesmo que você digita na Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Opcionais (só mude se a Meta pedir): versão da API e idioma dos modelos de mensagem.
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_IDIOMA_MODELOS=pt_BR

# Opcionais
# MODO_SIMULADOR=1   (liga o Simulador e o relógio simulado. Em produção fica desligado; use só para testar sem WhatsApp.)
# ROTINAS_AUTO=0     (desliga as rotinas automáticas de retomada etc.)
